# ==========================================
# NEXORA MAIL - Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Security & Session
# Secret key used for signing session cookies (min 32 random characters)
SESSION_SECRET=nexora_super_secret_session_key_32_chars_long_minimum_value

# 32-byte hexadecimal key for AES-256-GCM token encryption
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
# MongoDB Atlas Connection URI (Replace with your Atlas cluster URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nexora_mail?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/nexora_mail

# Google Cloud OAuth 2.0 Credentials (Get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# For Local Development:
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# For Render Production:
# GOOGLE_REDIRECT_URI=https://your-nexora-service.onrender.com/auth/google/callback
